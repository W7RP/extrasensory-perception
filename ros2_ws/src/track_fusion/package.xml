<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>track_fusion</name>
  <version>0.1.0</version>
  <description>C++20 multi-agent track fusion: constant-velocity Kalman filter per track, gating, swappable data association, track birth and deletion, real-time instrumented.</description>
  <maintainer email="jd.arrobas@proton.me">W7RP</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <depend>rclcpp</depend>
  <depend>coop_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>agent_estimation</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
