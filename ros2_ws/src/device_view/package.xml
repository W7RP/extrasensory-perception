<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>device_view</name>
  <version>0.1.0</version>
  <description>The ground device's see-through view: the tracks it holds, drawn on its own camera image where the entities really are, including behind walls.</description>
  <maintainer email="jd.arrobas@proton.me">W7RP</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <depend>rclcpp</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>coop_msgs</depend>
  <depend>synthetic_detector</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libsdl2-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
