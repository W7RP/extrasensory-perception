<?xml version="1.0" encoding="UTF-8"?>
<!-- Phase 1 world: PX4's default physics, magnetic field, lighting and
     geodetic origin (via the quad-autonomy-sim flow_field world), the textured
     flow_ground so the agents' optical flow can track, one building block, and
     the entity of interest parked behind it.

     Frame: Gazebo world, ENU (x east, y north, z up), metres. This is the
     shared "world" frame of every detection and track.

     The building is the only occluder. synthetic_detector reads its geometry
     from this file (every box collision of a static model), so moving or
     resizing it here changes occlusion everywhere; nothing is duplicated. -->
<sdf version="1.9">
  <world name="coop_field">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <include>
      <uri>model://flow_ground</uri>
    </include>
    <!-- Building block: 2 m thick (x), 20 m long (y), 6 m tall, centred on the
         origin. Agents fly at 4 m, below its roof, on both sides of its ends. -->
    <model name="building">
      <static>true</static>
      <pose>0 0 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2 20 6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2 20 6</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.55 0.57 0.6 1</diffuse>
            <ambient>0.55 0.57 0.6 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <!-- The ground device (Phase 2), parked at the start of its route; the
         scenario moves it. Phase 1 scenarios simply leave it standing. -->
    <include>
      <uri>model://device</uri>
      <name>device</name>
      <pose>-12 4 0 0 0 0</pose>
    </include>
    <!-- The entity of interest, parked at the start of its path; the scenario
         (sim/scenarios/two_agent_wall.yaml) moves it. -->
    <include>
      <uri>model://entity_person</uri>
      <name>entity</name>
      <pose>4 -6 0 0 0 0</pose>
    </include>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
