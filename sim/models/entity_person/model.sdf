<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- The entity of interest: a simple person-sized shape (1.75 m tall).
       Kinematic: static, so physics never moves it; scripts/scene_mover.py
       moves it along the scenario's path with Gazebo's set_pose service.
       Model origin is on the ground, between the feet. No collision: agents
       never fly near it, and a collision would only matter to physics. -->
  <model name="entity_person">
    <static>true</static>
    <link name="link">
      <visual name="body">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>1.44</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.85 0.35 0.1 1</diffuse>
          <ambient>0.85 0.35 0.1 1</ambient>
        </material>
      </visual>
      <visual name="head">
        <pose>0 0 1.6 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.85 0.35 0.1 1</diffuse>
          <ambient>0.85 0.35 0.1 1</ambient>
        </material>
      </visual>
    </link>
  </model>
</sdf>
