<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- The ground device: a camera at 1.6 m on a thin post, the height of a
       hand-held or tripod camera. Static and moved kinematically by
       scripts/scene_mover.py along the scenario's device route, facing its
       look-at point. Model origin on the ground; the model's +x is the
       camera's viewing direction.

       Camera: 640 x 480 at 15 Hz, 70 deg horizontal FOV. Gazebo cameras look
       along their link's +x with +y left and +z up; device_view projects
       with that convention. The camera pose here (0 0 1.6, level) must match
       device_view's `camera.mount_xyz` parameter (from the scenario). -->
  <model name="device">
    <static>true</static>
    <link name="link">
      <visual name="post">
        <pose>0 0 0.78 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>1.56</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.15 0.15 0.15 1</ambient>
        </material>
      </visual>
      <visual name="body">
        <pose>-0.03 0 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.18 0.12</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.3 0.8 1</diffuse>
          <ambient>0.1 0.3 0.8 1</ambient>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <pose>0 0 1.6 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>device/camera/image</topic>
        <camera>
          <horizontal_fov>1.2217</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>120</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
