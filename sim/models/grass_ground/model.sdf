<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Visual only: collision comes from the world's infinite ground plane. -->
  <model name="grass_ground">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><mesh><uri>model://grass_ground/meshes/ground.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr><metal>
            <albedo_map>model://grass_ground/materials/textures/grass.jpg</albedo_map>
            <roughness>0.95</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
