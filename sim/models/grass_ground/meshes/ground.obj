# 200 m x 200 m ground quad. UVs run 0..8, so with repeat addressing the
# texture tiles every 25 m (sim/tools/generate_grass_texture.py makes it seamless).
v -100.0 -100.0 0.0
v  100.0 -100.0 0.0
v  100.0  100.0 0.0
v -100.0  100.0 0.0
vt 0.0 0.0
vt 8.0 0.0
vt 8.0 8.0
vt 0.0 8.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
