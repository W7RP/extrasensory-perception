# 600 m x 600 m ground quad (wide enough that a camera 100+ m up sees no
# edge). UVs run 0..24, so with repeat addressing the texture tiles every 25 m
# (sim/tools/generate_grass_texture.py makes it seamless).
v -300.0 -300.0 0.0
v  300.0 -300.0 0.0
v  300.0  300.0 0.0
v -300.0  300.0 0.0
vt 0.0 0.0
vt 24.0 0.0
vt 24.0 24.0
vt 0.0 24.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
